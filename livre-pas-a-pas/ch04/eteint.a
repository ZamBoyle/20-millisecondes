;---------------------------------------------------------------
; 20 MILLISECONDES — chapitre 4 : le meme chronometre, ecran eteint
;
; On coupe l'affichage : le VIC n'a plus rien a lire, donc plus
; aucune Bad Line. Le processeur garde TOUS ses cycles, et les
; stries deviennent parfaitement regulieres.
;
; Assembler :   acme eteint.a
; Lancer :      LOAD"ETEINT",8,1  puis  RUN
;---------------------------------------------------------------
!to "eteint.prg", cbm

* = $0801                       ; 10 SYS 2064
!byte $0b,$08,$0a,$00,$9e,$32,$30,$36,$34,$00,$00,$00

* = $0810
        sei                     ; silence
        lda #$0b                ; comme $1b, mais l'interrupteur
        sta $d011               ;   « ecran allume » en moins

boucle  inc $d020               ; 6 cycles
        jmp boucle              ; 3 cycles -> 9 cycles par strie
